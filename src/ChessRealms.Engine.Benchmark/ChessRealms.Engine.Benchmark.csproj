  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessRealms.Engine.Perft\ChessRealms.Engine.Perft.csproj" />
    <ProjectReference Include="..\ChessRealms.Engine\ChessRealms.Engine.csproj" />
  </ItemGroup>

</Project>
